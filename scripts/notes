#!/usr/bin/env bash
# `notes` - one-word launcher for NoteTaker.
#
#   notes            open the menu (nothing to remember)
#   notes now        start recording straight away (microphone)
#   notes online     record an online lecture (Zoom/Teams/YouTube)
#   notes class      record a normal class, stopping at the end by itself
#   notes later      record the sound only, write the notes after school
#   notes catchup    write notes for every class that does not have them
#   notes last       show the notes from the most recent lecture
#   notes all        list every lecture
#   notes check      confirm the microphone and notes writer work
#   notes update     update NoteTaker safely from its Git repository
#   notes <anything else>  passed straight through to the full CLI
#
# Plain-English words are accepted for every action, because a user who has
# not read the docs will type what they mean, not a flag.
#
# Everything runs offline on this machine.

set -euo pipefail

APP_DIR="/home/gamingrf/Documents/Projects/NoteTaker"
PY="$APP_DIR/.venv/bin/python"

if [[ ! -x "$PY" ]]; then
    echo "NoteTaker is not set up at $APP_DIR" >&2
    echo "Run its install.sh to finish setting it up." >&2
    exit 1
fi

auto_update() {
    # Startup updates are opt-out and never block opening the app.
    [[ "${NOTES_AUTO_UPDATE:-1}" == "0" ]] && return 0
    [[ "${1-}" == "update" || "${1-}" == "upgrade" ]] && return 0
    command -v git >/dev/null || return 0

    # Never overwrite a checkout that contains user work, including the
    # untracked files commonly created while developing locally.
    local status
    status="$(cd "$APP_DIR" && git status --porcelain 2>/dev/null || true)"
    [[ -n "$status" ]] && return 0

    # The real reason is already printed by the update command; this only adds
    # what to do next. Never say "skipped": a failed dependency refresh happens
    # after the code has already changed, and claiming nothing happened would
    # send the user looking in the wrong place.
    if ! (cd "$APP_DIR" && "$PY" -m notetaker.cli update --quiet); then
        echo "Continuing without updating. Run 'notes update' later to retry." >&2
    fi
}

auto_update "${1-}"

run() { cd "$APP_DIR" && exec "$PY" -m notetaker.cli "$@"; }

latest_session() {
    cd "$APP_DIR" && "$PY" - <<'PY'
from notetaker import store
sessions = store.list_sessions(limit=1)
print(sessions[0].id if sessions else "")
PY
}

case "${1-}" in
    # Bare `notes` opens the menu: the user does not have to know anything.
    "")
        run menu
        ;;
    now|start|record|go|mic|lecture)
        shift
        run record --source mic --live-notes "$@"
        ;;
    # A normal school period: stops by itself at the end, so nobody has to
    # remember to press anything while packing up.
    class|period|lesson)
        shift
        run record --source mic --live-notes --minutes "${NOTES_CLASS_MINUTES:-60}" "$@"
        ;;
    # Record the sound only. No model runs during the lesson, so the laptop
    # stays cool and the battery lasts a whole day of classes.
    later|quick|save)
        shift
        run record --source mic --later --minutes "${NOTES_CLASS_MINUTES:-60}" "$@"
        ;;
    catchup|writeup|finish|homework)
        shift
        run catchup "$@"
        ;;
    online|zoom|teams|system|meet|youtube)
        shift
        run record --source system --live-notes "$@"
        ;;
    last|latest|read)
        latest="$(latest_session)"
        if [[ -z "$latest" ]]; then
            echo "No lectures recorded yet. Run: notes now"
            exit 0
        fi
        run show "$latest"
        ;;
    all|ls|list)
        run list
        ;;
    check|test|doctor|setup)
        run check
        ;;
    update|upgrade)
        shift
        run update "$@"
        ;;
    menu)
        run menu
        ;;
    help|-h|--help)
        cat <<'EOF'
notes            open the menu - pick what you want from a list
notes class      record a class; stops by itself after 60 minutes
notes later      record the sound only; write the notes after school
notes catchup    write notes for every class that does not have them yet
notes now        record until you press Ctrl-C (a long lecture)
notes online     record an online class (Zoom/Teams/YouTube)
notes last       show the notes from your last class
notes all        list every class
notes check      confirm the microphone and notes writer work
notes update     update NoteTaker safely from its Git repository
notes lang       add or list note languages

'notes class' stops on its own. Ctrl-C always stops sooner.
Set a different class length with:  NOTES_CLASS_MINUTES=45 notes class

Anything else is passed to the full CLI, for example:
  notes record --title "Physics week 4" --lang th
  notes summarize physics --hq
  notes export physics -o notes.md
  notes lang add ja
EOF
        ;;
    *)
        run "$@"
        ;;
esac
